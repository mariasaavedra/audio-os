{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@m7/audio-os/ui/primitives": ["./primitives/src/index.ts"],
      "@m7/audio-os/ui/primitives/*": ["./primitives/src/*"],
      "@m7/audio-os/ui/feedback": ["./feedback/src/index.ts"],
      "@m7/audio-os/ui/navigation": ["./navigation/src/index.ts"],
      "@m7/audio-os/shared/utils": ["../shared/utils/src/index.ts"],
      "@m7/audio-os/shared/utils/*": ["../shared/utils/src/*"]
    }
  },
  "include": ["primitives/src", "feedback/src", "navigation/src"]
}
